{
  "name": "nitya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "npx dotenv -e .env.test -- next dev",
    "build": "npm run build:docs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "db:download": "node scripts/download-database.mjs",
    "db:download:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true node scripts/download-database.mjs",
    "db:upload": "node scripts/upload-database.mjs",
    "db:upload:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true node scripts/upload-database.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .storybook-static && rm -rf public/developer/documentation/storybook && mkdir -p public/developer/documentation && cp -r .storybook-static public/developer/documentation/storybook",
    "build:typedoc": "npx typedoc",
    "build:docs": "npm run build-storybook && npm run build:typedoc"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "@google-cloud/storage": "^7.18.0",
    "@tanstack/react-query": "^5.90.18",
    "firebase": "^12.6.0",
    "next": "16.0.10",
    "openai": "^6.16.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "firebase-tools": "^15.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "storybook": "^10.2.4",
    "@storybook/nextjs-vite": "^10.2.4",
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/addon-a11y": "^10.2.4",
    "@storybook/addon-docs": "^10.2.4",
    "@storybook/addon-onboarding": "^10.2.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "playwright": "^1.58.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "typedoc": "^0.27.0"
  }
}

# Firebase Emulator Configuration for E2E Tests
# These settings will connect to local Firebase emulators instead of production

# Base URL for the application
BASE_URL=http://localhost:3000

# Firebase Project ID (for emulator)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-test
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key-for-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-test.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Emulator configuration
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Test user credentials
TEST_USER_EMAIL=test@goalchaser.test
TEST_USER_PASSWORD=TestPassword123!

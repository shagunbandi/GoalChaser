# Dependencies (all workspaces)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Generated docs (any public folder, e.g. apps/web/public)
**/public/developer/documentation/

# Testing
coverage/
.nyc_output/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
*.trace
*.zip

# Environment files (do not commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.test
!.env.local.example

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
firebase-debug.log
firestore-debug.log
ui-debug.log

# OS & editors
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
.idea/
.vscode/
*.sublime-*

# Vercel
.vercel

# TypeScript
next-env.d.ts

# PWA / Service Worker (generated)
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/worker-*.js
**/public/worker-*.js.map
**/public/fallback-*.js
**/public/fallback-*.js.map

# Firebase
.firebase/
.emulator-data/

# Secrets (NEVER commit)
*-key.json
service-account*.json
gcs-key.json
# Secrets directory - all files except examples
secrets/*
!secrets/.env.example

# Generated / backup data
dummy-user-data.json
*-backup.json

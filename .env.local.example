# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your Apps > Config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Uncomment to use Firebase Emulators for local development
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Google Cloud Storage Configuration
# For file uploads (travel attachments)
# See GCS_SETUP.md for setup instructions

GCS_BUCKET_NAME=travelfiles

# Service Account Key (choose one option):

# Option 1: Relative path to key file (recommended for development)
# Place your service account key in project root as gcs-key.json
GCS_KEY_FILE=./gcs-key.json

# Option 2: Absolute path to key file (alternative)
# GCS_KEY_FILE=/Users/yourusername/secrets/goal-chaser-gcs-key.json

# Option 3: JSON credentials as string (for production/Vercel)
# GCS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

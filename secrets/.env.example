# Firebase Configuration (REQUIRED)
# Get these from Firebase Console > Project Settings > Your Apps > Config

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-xxxxxxxxxx

# OpenAI (REQUIRED for Language Tutor and Executive Goal plugins)
OPENAI_API_KEY=sk-your-openai-key

# Google Maps (REQUIRED for Travel plugin)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Google Cloud Storage (for file uploads in Travel plugin)
GCS_BUCKET_NAME=your-bucket-name
# For local dev (Docker overrides this path in docker-compose.yml)
GCS_KEY_FILE=../../secrets/gcs-key.json
